PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/task_board
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the Socket.io Redis adapter for multi-instance scaling.
# Leave blank for local dev - the server falls back to single-instance mode.
REDIS_URL=

# Required for task attachment uploads (Multer -> Cloudinary). Get these
# from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
